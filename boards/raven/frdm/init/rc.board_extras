#!/bin/sh
# Start tested core services. No sensor driver or motor output driver is started.
dataman start -r
load_mon start
send_event start
sensors start
ekf2 start
commander start
manual_control start
flight_mode_manager start
mc_att_control start
mc_rate_control start
mc_pos_control start
control_allocator start
land_detector start multicopter
navigator start
# MAVLink-only logging avoids requiring unvalidated persistent storage.
logger start -m mavlink
mavlink boot_complete
. /etc/extras/rc.board_dds
